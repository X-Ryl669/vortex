<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="0dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_laptop_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/ic_notification_laptop"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/notification_laptop_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Earbuds: tap anywhere (icon OR battery text) to switch. -->
    <LinearLayout
        android:id="@+id/notification_audio_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/notification_audio_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/ic_notification_earbuds"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/notification_audio_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/notification_lock_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:clickable="true"
        android:focusable="false"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notification_lock_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notification_lock_open"
            android:tint="@android:color/white" />
    </FrameLayout>

    <!-- Spacer: pushes the clipboard-send button to the far right edge.
         RemoteViews can't inflate a plain <View>, so use a weighted
         empty TextView. -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <!-- Send-clipboard button (top-right). Always visible while sync is on. -->
    <FrameLayout
        android:id="@+id/notification_clipboard_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:clickable="true"
        android:focusable="false"
        android:paddingStart="10dp"
        android:paddingEnd="2dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/notification_clipboard_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_notification_clipboard"
            android:tint="@android:color/white" />
    </FrameLayout>

</LinearLayout>
