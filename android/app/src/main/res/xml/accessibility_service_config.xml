<?xml version="1.0" encoding="utf-8"?>
<!-- Screen-control injector (canPerformGestures: the laptop drives this phone's
     touch UI while mirroring) + browsing-handoff reader (canRetrieveWindowContent:
     read the browser address bar so the laptop can offer to continue the page).
     Window state + content changes drive the handoff URL read (debounced).
     flagReportViewIds is REQUIRED for findAccessibilityNodeInfosByViewId() to
     resolve the browser's address-bar node (e.g. com.android.chrome:id/url_bar);
     without it that lookup silently returns nothing and the auto-handoff pill
     never fires (only the explicit Share path works). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:accessibilityFlags="flagReportViewIds"
    android:description="@string/screen_control_service_desc"
    android:notificationTimeout="100" />
